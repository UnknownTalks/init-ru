		{"id":"g-processing","type":"group","x":560,"y":-100,"width":540,"height":1040,"label":"Обработка • 6 мин • 10%","color":"4"},
		{"id":"g-llm","type":"group","x":1160,"y":-100,"width":2940,"height":1040,"label":"Создание и устройство LLM • 33 мин • 55%","color":"6"},
